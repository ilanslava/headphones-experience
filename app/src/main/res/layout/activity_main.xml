<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="#080808">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUT ON YOUR HEADPHONES" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Something is waiting to be heard." android:textColor="#AAAAAA" android:textSize="17sp" android:gravity="center" />
    <Button android:id="@+id/begin" android:layout_width="220dp" android:layout_height="56dp" android:layout_marginTop="48dp" android:text="BEGIN" />
</LinearLayout>
